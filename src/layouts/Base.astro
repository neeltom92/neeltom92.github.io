---
import "../styles/global.css";

const SITE_TITLE = "Codeworks";
const DEFAULT_DESC =
  "Neel Thomas Thelly is an independent AI, cloud and DevOps consultant in Mesa, Arizona. Through his practice, Codeworks, he works with teams across Phoenix, Scottsdale, Tempe, Chandler and Gilbert on AWS, Azure, CI/CD, Kubernetes, monitoring and AI projects.";
const KEYWORDS =
  "DevOps consulting Phoenix, AI consultant Phoenix, cloud consulting Phoenix, AWS consultant Arizona, Azure consultant Phoenix, Kubernetes consultant Phoenix, AI infrastructure consulting Arizona, SRE consulting, AIOps, MLOps, LLMOps, platform engineering, Kubernetes consulting, AWS consulting, observability, MCP, LLM agents, Scottsdale, Tempe, Chandler, Gilbert, Mesa, Neel Thomas Thelly, Codeworks";
const BOOKING = "https://calendly.com/neeltom92/new-meeting";
const CITIES = ["Phoenix", "Scottsdale", "Tempe", "Chandler", "Gilbert", "Mesa"];

interface Props {
  title?: string;
  description?: string;
  isHome?: boolean;
  schema?: object[]; // extra page-level JSON-LD
  noindex?: boolean;
}

const { title, description = DEFAULT_DESC, isHome = false, schema = [], noindex = false } = Astro.props;
const pageTitle = title ?? `AI, Cloud & DevOps Consultant in Phoenix, AZ | ${SITE_TITLE}`;

const ogImage = new URL("/images/og.png", Astro.site).href;
const photo = new URL("/images/N90.jpg", Astro.site).href;
const siteUrl = Astro.site?.href ?? "https://codeworks.cloud/";

const navItems = [
  { name: "Services", url: "/#services" },
  { name: "About", url: "/about/" },
  { name: "Projects", url: "/projects/" },
  { name: "Résumé", url: "/resume/" },
  { name: "Contact", url: "/contact/" },
];

const businessSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${siteUrl}#business`,
  name: SITE_TITLE,
  alternateName: "Codeworks Cloud",
  url: siteUrl,
  image: ogImage,
  logo: new URL("/images/apple-touch-icon.png", Astro.site).href,
  description: DEFAULT_DESC,
  email: "mailto:neeltom92@gmail.com",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Mesa",
    addressRegion: "AZ",
    addressCountry: "US",
  },
  areaServed: CITIES.map((name) => ({ "@type": "City", name: `${name}, AZ` })),
  founder: { "@id": `${siteUrl}#person` },
  knowsAbout: [
    "AI infrastructure", "LLMOps", "AIOps", "Site Reliability Engineering",
    "Platform Engineering", "Kubernetes", "Observability", "Model Context Protocol",
    "Cloud cost optimization", "AWS", "Azure",
  ],
  sameAs: ["https://github.com/neeltom92", "https://www.linkedin.com/in/neel-thomas-thelly-646a27131/"],
};

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${siteUrl}#person`,
  name: "Neel Thomas Thelly",
  url: siteUrl,
  image: photo,
  jobTitle: "Independent AI, Cloud & DevOps Consultant",
  worksFor: { "@id": `${siteUrl}#business` },
  email: "mailto:neeltom92@gmail.com",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Mesa",
    addressRegion: "AZ",
    addressCountry: "US",
  },
  knowsAbout: [
    "Kubernetes", "Site Reliability Engineering", "DevOps", "Observability",
    "AWS", "Terraform", "AIOps", "Model Context Protocol",
    "Platform Engineering", "OpenTelemetry", "Python", "GitOps",
    "Incident Response", "Prometheus", "Datadog",
  ],
  sameAs: [
    "https://github.com/neeltom92",
    "https://www.linkedin.com/in/neel-thomas-thelly-646a27131/",
    "https://twitter.com/NEELTHOMAS11",
    "https://medium.com/@neeltom92",
  ],
};

const year = new Date().getFullYear();

// Copper star from the Arizona flag — the brand mark.
const STAR = Array.from({ length: 10 }, (_, i) => {
  const a = -Math.PI / 2 + (i * Math.PI) / 5;
  const r = i % 2 ? 3.8 : 9.6;
  return `${(10 + r * Math.cos(a)).toFixed(2)},${(10.6 + r * Math.sin(a)).toFixed(2)}`;
}).join(" ");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={KEYWORDS} />
    <meta name="author" content="Neel Thomas Thelly" />
    <meta name="robots" content={noindex ? "noindex" : "index, follow, max-image-preview:large, max-snippet:-1"} />
    <meta name="geo.region" content="US-AZ" />
    <meta name="geo.placename" content="Mesa, Arizona" />
    <meta name="theme-color" content="#edf1ef" />
    <link rel="canonical" href={Astro.url.href} />

    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Codeworks: independent AI, cloud and DevOps consulting by Neel Thomas Thelly in Phoenix, Arizona" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@NEELTHOMAS11" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Overpass:wght@400;600;700;800;900&family=Overpass+Mono:wght@400;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap"
    />

    {(isHome || schema.length > 0) && (
      <script type="application/ld+json" set:html={JSON.stringify([...(isHome ? [businessSchema, personSchema] : []), ...schema])} />
    )}

    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <header class="nav">
      <div class="nav__in">
        <a class="nav__brand" href="/">
          <svg class="nav__star" viewBox="0 0 20 20" aria-hidden="true"><polygon points={STAR} /></svg>Codeworks
        </a>
        <nav class="nav__links" aria-label="primary">
          {navItems.map((item) => (
            <a class="nav__link" href={item.url}>
              {item.name}
            </a>
          ))}
        </nav>
        <a class="nav__cta" href={BOOKING} target="_blank" rel="noopener">Book a free call</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="foot">
      <div class="foot__in">
        <div class="foot__top">
        <div class="foot__brand">
          <span class="foot__big"><svg class="nav__star" viewBox="0 0 20 20" aria-hidden="true"><polygon points={STAR} /></svg>Codeworks</span>
          <span class="foot__tag">Independent AI, cloud and DevOps consulting by Neel Thomas Thelly, based in Mesa, Arizona.</span>
        </div>
        <div class="foot__grid">
          <div class="foot__col">
            <span class="foot__k">elsewhere</span>
            <a href="https://github.com/neeltom92" target="_blank" rel="noopener">GitHub ↗</a>
            <a href="https://www.linkedin.com/in/neel-thomas-thelly-646a27131/" target="_blank" rel="noopener">LinkedIn ↗</a>
            <a href="https://medium.com/@neeltom92" target="_blank" rel="noopener">Medium ↗</a>
            <a href="https://twitter.com/NEELTHOMAS11" target="_blank" rel="noopener">X / Twitter ↗</a>
          </div>
          <div class="foot__col">
            <span class="foot__k">direct</span>
            <a href={BOOKING} target="_blank" rel="noopener">Book a call ↗</a>
            <a href="mailto:neeltom92@gmail.com">neeltom92@gmail.com</a>
            <span class="foot__loc">Based in Mesa, serving the Phoenix metro</span>
            <span class="foot__loc"><span class="foot__live"></span> taking new projects</span>
          </div>
        </div>
        </div>
        <div class="foot__base">
          <span>© {year} Codeworks · Neel Thomas Thelly</span>
          <span>Mesa, Arizona</span>
        </div>
      </div>
    </footer>

    <script>
      // scroll reveal
      const els = document.querySelectorAll<HTMLElement>(".reveal");
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduce || !("IntersectionObserver" in window)) {
        els.forEach((el) => el.classList.add("in"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                (e.target as HTMLElement).classList.add("in");
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
