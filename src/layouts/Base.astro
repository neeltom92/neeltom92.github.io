---
import "../styles/global.css";

const SITE_TITLE = "Codeworks";
const DEFAULT_DESC =
  "Codeworks is an AI, cloud and DevOps consulting company in Mesa, Arizona serving Phoenix, Scottsdale, Tempe, Chandler and Gilbert. AWS and Azure consulting, CI/CD, Kubernetes, monitoring and AI implementation. Fixed-price projects.";
const KEYWORDS =
  "DevOps consulting Phoenix, AI consultant Phoenix, cloud consulting Phoenix, AWS consultant Arizona, Azure consultant Phoenix, Kubernetes consultant Phoenix, AI infrastructure consulting Arizona, SRE consulting, AIOps, MLOps, LLMOps, platform engineering, Kubernetes consulting, AWS consulting, observability, MCP, LLM agents, Scottsdale, Tempe, Chandler, Gilbert, Mesa, Neel Thomas Thelly, Codeworks";
const BOOKING = "https://calendly.com/neeltom92/new-meeting";
const CITIES = ["Phoenix", "Scottsdale", "Tempe", "Chandler", "Gilbert", "Mesa"];

interface Props {
  title?: string;
  description?: string;
  isHome?: boolean;
  schema?: object[]; // extra page-level JSON-LD
  noindex?: boolean;
}

const { title, description = DEFAULT_DESC, isHome = false, schema = [], noindex = false } = Astro.props;
const pageTitle = title ?? `${SITE_TITLE} | AI, Cloud & DevOps Consulting in Phoenix, AZ`;

const ogImage = new URL("/images/og.png", Astro.site).href;
const photo = new URL("/images/N90.jpg", Astro.site).href;
const siteUrl = Astro.site?.href ?? "https://codeworks.cloud/";

const navItems = [
  { name: "Services", url: "/#services", idx: "01" },
  { name: "About", url: "/about/", idx: "02" },
  { name: "Projects", url: "/projects/", idx: "03" },
  { name: "Resume", url: "/resume/", idx: "04" },
  { name: "Contact", url: "/contact/", idx: "05" },
];

const businessSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${siteUrl}#business`,
  name: SITE_TITLE,
  alternateName: "Codeworks Cloud",
  url: siteUrl,
  image: ogImage,
  logo: new URL("/images/apple-touch-icon.png", Astro.site).href,
  description: DEFAULT_DESC,
  slogan: "AI that ships. Systems that stay up.",
  email: "mailto:neeltom92@gmail.com",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Mesa",
    addressRegion: "AZ",
    addressCountry: "US",
  },
  areaServed: CITIES.map((name) => ({ "@type": "City", name: `${name}, AZ` })),
  founder: { "@id": `${siteUrl}#person` },
  knowsAbout: [
    "AI infrastructure", "LLMOps", "AIOps", "Site Reliability Engineering",
    "Platform Engineering", "Kubernetes", "Observability", "Model Context Protocol",
    "Cloud cost optimization", "AWS", "Azure",
  ],
  sameAs: ["https://github.com/neeltom92", "https://www.linkedin.com/in/neel-thomas-thelly-646a27131/"],
};

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${siteUrl}#person`,
  name: "Neel Thomas Thelly",
  url: siteUrl,
  image: photo,
  jobTitle: "Founder, AI Infrastructure & SRE Consultant",
  worksFor: { "@id": `${siteUrl}#business` },
  email: "mailto:neeltom92@gmail.com",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Mesa",
    addressRegion: "AZ",
    addressCountry: "US",
  },
  knowsAbout: [
    "Kubernetes", "Site Reliability Engineering", "DevOps", "Observability",
    "AWS", "Terraform", "AIOps", "Model Context Protocol",
    "Platform Engineering", "OpenTelemetry", "Python", "GitOps",
    "Incident Response", "Prometheus", "Datadog",
  ],
  sameAs: [
    "https://github.com/neeltom92",
    "https://www.linkedin.com/in/neel-thomas-thelly-646a27131/",
    "https://twitter.com/NEELTHOMAS11",
    "https://medium.com/@neeltom92",
  ],
};

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={KEYWORDS} />
    <meta name="author" content="Neel Thomas Thelly" />
    <meta name="robots" content={noindex ? "noindex" : "index, follow, max-image-preview:large, max-snippet:-1"} />
    <meta name="geo.region" content="US-AZ" />
    <meta name="geo.placename" content="Mesa, Arizona" />
    <meta name="theme-color" content="#0a0e0d" />
    <link rel="canonical" href={Astro.url.href} />

    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Codeworks: AI, cloud and DevOps consulting in Phoenix, Arizona" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@NEELTHOMAS11" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=JetBrains+Mono:wght@400;500;700&display=swap"
    />

    {(isHome || schema.length > 0) && (
      <script type="application/ld+json" set:html={JSON.stringify([...(isHome ? [businessSchema, personSchema] : []), ...schema])} />
    )}

    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <!-- atmosphere -->
    <div class="fx-grain" aria-hidden="true"></div>
    <div class="fx-scan" aria-hidden="true"></div>
    <div class="fx-glow" aria-hidden="true"></div>

    <header class="nav">
      <div class="nav__in">
        <a class="nav__brand" href="/">
          <span class="nav__dot" aria-hidden="true"></span>codeworks<span class="nav__brand-accent">.cloud</span>
        </a>
        <nav class="nav__links" aria-label="primary">
          {navItems.map((item) => (
            <a class="nav__link" href={item.url}>
              <span class="nav__idx">{item.idx}</span>{item.name}
            </a>
          ))}
        </nav>
        <a class="nav__cta" href={BOOKING} target="_blank" rel="noopener">Book a call ↗</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="foot">
      <div class="foot__in">
        <div class="foot__brand">
          <span class="foot__big">CODEWORKS</span>
          <span class="foot__tag">// AI, cloud & DevOps consulting · Mesa, AZ · founded by Neel Thomas Thelly</span>
        </div>
        <div class="foot__grid">
          <div class="foot__col">
            <span class="foot__k">elsewhere</span>
            <a href="https://github.com/neeltom92" target="_blank" rel="noopener">GitHub ↗</a>
            <a href="https://www.linkedin.com/in/neel-thomas-thelly-646a27131/" target="_blank" rel="noopener">LinkedIn ↗</a>
            <a href="https://medium.com/@neeltom92" target="_blank" rel="noopener">Medium ↗</a>
            <a href="https://twitter.com/NEELTHOMAS11" target="_blank" rel="noopener">X / Twitter ↗</a>
          </div>
          <div class="foot__col">
            <span class="foot__k">direct</span>
            <a href={BOOKING} target="_blank" rel="noopener">Book a call ↗</a>
            <a href="mailto:neeltom92@gmail.com">neeltom92@gmail.com</a>
            <span class="foot__loc">Mesa, AZ · serving the Phoenix metro</span>
            <span class="foot__loc"><span class="foot__live"></span> taking new projects</span>
          </div>
        </div>
        <div class="foot__base">
          <span>© {year} Codeworks · Neel Thomas Thelly</span>
          <span>built with Astro · deployed on Cloudflare</span>
        </div>
      </div>
    </footer>

    <script>
      // cinematic scroll reveal
      const els = document.querySelectorAll<HTMLElement>(".reveal");
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduce || !("IntersectionObserver" in window)) {
        els.forEach((el) => el.classList.add("in"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                (e.target as HTMLElement).classList.add("in");
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
        );
        els.forEach((el) => io.observe(el));
      }

      // project cards — cursor-follow phosphor spotlight
      document.querySelectorAll<HTMLElement>(".proj").forEach((card) => {
        card.addEventListener("pointermove", (e) => {
          const r = card.getBoundingClientRect();
          card.style.setProperty("--mx", `${((e.clientX - r.left) / r.width) * 100}%`);
          card.style.setProperty("--my", `${((e.clientY - r.top) / r.height) * 100}%`);
        });
      });

      // hero panel — live p50-latency sparkline (the site monitoring itself)
      const spark = document.querySelector<SVGSVGElement>(".spark");
      if (spark) {
        const line = spark.querySelector<SVGPolylineElement>(".spark__line")!;
        const dot = spark.querySelector<SVGCircleElement>(".spark__dot")!;
        const msEl = document.querySelector<HTMLElement>("[data-ms]");
        const N = 28, W = 240, H = 48, PAD = 5;
        const xOf = (i: number) => (i / (N - 1)) * W;
        const yOf = (v: number) => H - PAD - v * (H - 2 * PAD);
        const sample = () =>
          Math.random() < 0.12 ? 0.82 + Math.random() * 0.14 : 0.26 + Math.random() * 0.32;
        const ms = (v: number) => Math.round(34 + v * 150);
        const render = (arr: number[]) => {
          line.setAttribute(
            "points",
            arr.map((v, i) => `${xOf(i).toFixed(1)},${yOf(v).toFixed(1)}`).join(" ")
          );
          dot.setAttribute("cy", yOf(arr[N - 1]).toFixed(1));
        };
        let data = Array.from({ length: N }, sample);

        if (reduce) {
          render(data);
          if (msEl) msEl.textContent = `${ms(data[N - 1])} ms`;
        } else {
          let from = data.slice();
          let to = data.slice();
          let t0 = performance.now();
          const DUR = 1200;
          const ease = (p: number) => (p < 0.5 ? 2 * p * p : 1 - Math.pow(-2 * p + 2, 2) / 2);
          const push = () => {
            from = to.slice();
            data = data.slice(1);
            data.push(sample());
            to = data.slice();
            t0 = performance.now();
            if (msEl) msEl.textContent = `${ms(to[N - 1])} ms`;
          };
          const frame = (now: number) => {
            const e = ease(Math.min(1, (now - t0) / DUR));
            render(from.map((v, i) => v + (to[i] - v) * e));
            requestAnimationFrame(frame);
          };
          push();
          setInterval(push, DUR);
          requestAnimationFrame(frame);
        }
      }
    </script>
  </body>
</html>
