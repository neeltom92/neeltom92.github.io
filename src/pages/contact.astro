---
import Base from "../layouts/Base.astro";

const resumeView = "/resume/";
const booking = "https://calendly.com/neeltom92/new-meeting";
const description =
  "Contact Codeworks for a free consultation on AI, cloud and DevOps projects. Based in Mesa, AZ, serving the Phoenix metro.";

const channels = [
  { k: "Book a call", v: "free consultation", href: booking, ext: true },
  { k: "Email", v: "neeltom92@gmail.com", href: "mailto:neeltom92@gmail.com", ext: false },
  { k: "LinkedIn", v: "in/neel-thomas-thelly", href: "https://www.linkedin.com/in/neel-thomas-thelly-646a27131/", ext: true },
  { k: "GitHub", v: "@neeltom92", href: "https://github.com/neeltom92", ext: true },
  { k: "Medium", v: "@neeltom92", href: "https://medium.com/@neeltom92", ext: true },
  { k: "X / Twitter", v: "@NEELTHOMAS11", href: "https://twitter.com/NEELTHOMAS11", ext: true },
  { k: "Résumé", v: "view online", href: resumeView, ext: false },
];
---

<Base title="Contact · Codeworks" description={description}>
  <section class="contact">
    <div class="wrap">
      <div class="contact__grid">
        <div>
          <p class="eyebrow">Contact · channels</p>
          <h1 class="contact__title">Let's talk about<br>your project</h1>
          <p class="sec__intro">
            Book a free consultation or send an email. Tell us what's broken or what you
            want to build, and you'll get an honest answer on whether Codeworks can help.
            Based in Mesa, with on-site visits across the Phoenix metro.
          </p>
          <p class="contact__live"><span class="nav__dot" aria-hidden="true"></span> taking new projects · replies within 1 business day · Mesa, AZ</p>

          <div class="btn-row" style="margin-top:2rem">
            <a class="btn btn--primary" href={booking} target="_blank" rel="noopener">Book a free consultation ↗</a>
            <a class="btn" href="mailto:neeltom92@gmail.com">Email</a>
            <a class="btn" href="https://www.linkedin.com/in/neel-thomas-thelly-646a27131/" target="_blank" rel="noopener">LinkedIn ↗</a>
          </div>
        </div>

        <div class="panel" aria-label="contact channels">
          <div class="panel__head"><span class="nav__dot" aria-hidden="true" style="animation:none"></span> reach me</div>
          {channels.map((c) => (
            <a class="chan" href={c.href} {...(c.ext ? { target: "_blank", rel: "noopener" } : {})}>
              <span class="chan__k">{c.k}</span>
              <span class="chan__v">{c.v}</span>
              <span class="chan__go" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</Base>
