---
import Base from "../layouts/Base.astro";

const booking = "https://calendly.com/neeltom92/new-meeting";

// "Sound familiar?" — the problems people actually call about.
const symptoms = [
  "Your AWS or Azure bill keeps going up and nobody can explain why.",
  "Deployments are manual, slow or risky, so your team ships less often than it should.",
  "You hear about outages from customers before your monitoring tells you.",
  "Your AI pilot works in a demo, but nobody trusts it with real customers or real data.",
  "The one person who understands your infrastructure is overloaded, or just left.",
  "You need senior DevOps help but can't justify a full-time hire yet.",
];

const services = [
  {
    tag: "start here",
    title: "Infrastructure & AI Readiness Assessment",
    desc: "A review of your cloud setup, deployments, monitoring, security and costs. You get a written report with what's working, what's risky, and a prioritized list of fixes.",
    stack: ["Written report", "Risk list", "Cost review", "Action plan"],
  },
  {
    tag: "cloud",
    title: "AWS & Azure Cloud Consulting",
    desc: "Cloud architecture, migrations and cost reduction. We find the waste in your bill and set up accounts, networking and access the right way.",
    stack: ["AWS", "Azure", "Cost reduction", "Migrations"],
  },
  {
    tag: "devops",
    title: "DevOps & CI/CD",
    desc: "Automated build, test and deploy pipelines so releases are routine. Infrastructure written as code, so every environment can be rebuilt and reviewed.",
    stack: ["GitHub Actions", "Terraform", "ArgoCD", "GitOps"],
  },
  {
    tag: "kubernetes",
    title: "Kubernetes & Platform Engineering",
    desc: "New EKS clusters, upgrades, autoscaling and security policies. Or an honest answer that you don't need Kubernetes yet.",
    stack: ["EKS", "Helm", "Karpenter", "Istio"],
  },
  {
    tag: "sre",
    title: "Monitoring & Reliability (SRE)",
    desc: "Dashboards and alerts that catch problems before customers do. On-call setup, uptime targets and incident reviews that stop repeat outages.",
    stack: ["Prometheus", "Grafana", "Datadog", "OpenTelemetry"],
  },
  {
    tag: "ai",
    title: "AI Implementation",
    desc: "Take a chatbot, agent or LLM pilot live safely: private deployment, access control, cost tracking and quality checks. We also build AI assistants that help your engineers debug incidents faster.",
    stack: ["LLMs", "RAG", "MCP", "Claude", "AWS Bedrock"],
  },
  {
    tag: "ongoing",
    title: "Fractional DevOps Lead",
    desc: "A senior DevOps and SRE engineer on your team part-time, on a monthly basis. Owns the roadmap, reviews changes, handles escalations and mentors your developers.",
    stack: ["Monthly", "Part-time", "No long contract"],
  },
];

// Real results from Neel's previous roles (not Codeworks clients).
const results = [
  {
    co: "Careem · an Uber company",
    metric: "$336K / year saved",
    challenge: "Growing AWS costs for the Careem Pay payments business, with production running on Elastic Beanstalk.",
    work: "Cost optimization across AWS and a migration of production to Kubernetes (EKS).",
  },
  {
    co: "Zolve · $210M neobank",
    metric: "Platform built from zero",
    challenge: "A new US fintech with no cloud platform and a launch to hit.",
    work: "Built the full AWS and Kubernetes platform: 20+ services on multi-region EKS, CI/CD, GitOps and monitoring.",
  },
  {
    co: "Life360 · 100M+ users",
    metric: "125+ services monitored",
    challenge: "Monitoring and logging for a consumer app used by more than 100 million people.",
    work: "Ran the observability stack (6TB+ of logs a day, Prometheus on EKS, OpenTelemetry) and built internal AI tools adopted by 10+ teams.",
  },
  {
    co: "Ola Cabs",
    metric: "~20% infra savings",
    challenge: "High infrastructure costs for payment workloads.",
    work: "Migrated payment workloads from AWS to Azure and ran large-scale CI/CD.",
  },
];

const projects = [
  {
    tag: "open source · 14 ★", href: "https://github.com/neeltom92/sre-copilot",
    title: "SRE Copilot",
    desc: "An AI assistant for incident debugging. Engineers ask questions in plain English and it pulls metrics, logs and traces from Datadog, Kubernetes and PagerDuty.",
    stack: ["Claude", "LangGraph", "Datadog", "MCP"],
  },
  {
    tag: "open source · 10+ ★", href: "https://github.com/neeltom92/eagle-eye-mcp",
    title: "Eagle-Eye",
    desc: "One screen for on-call engineers with metrics, logs, alerts and debugging context, so nobody has to jump between ten tabs during an outage.",
    stack: ["Observability", "MCP", "Incident response"],
  },
  {
    tag: "open source · new", href: "https://github.com/neeltom92/claude-code-observability",
    title: "Claude Code Observability",
    desc: "Self-hosted dashboards that show how a team uses AI coding tools: cost, token usage and which tools get used most. Runs locally with one <code>make up</code>.",
    stack: ["Grafana", "OpenTelemetry", "Prometheus", "Loki"],
  },
];

const goodFit = [
  "Startups and mid-size companies in the Phoenix area running on AWS or Azure",
  "Software teams with developers but no dedicated DevOps or SRE engineer",
  "Companies with an AI pilot that needs to go live safely",
  "Finance, healthcare and other regulated teams that need work done properly and documented",
];

const notFit = [
  "Help desk, laptops, email or office IT. A managed IT provider is the right call there.",
  "Website hosting or WordPress sites",
  "AI strategy slide decks with no build work behind them",
];

const coverage = [
  { h: "Service area", tags: ["Phoenix", "Scottsdale", "Tempe", "Chandler", "Gilbert", "Mesa", "Remote across the US"] },
  { h: "Industries", tags: ["Financial services & fintech", "Healthcare", "Semiconductor & manufacturing", "Logistics", "SaaS & startups"] },
];

const steps = [
  { when: "Step 01", role: "Free consultation", desc: "Book a time on the calendar. We talk through what's broken or what you want to build. No sales pitch." },
  { when: "Step 02", role: "Written proposal", desc: "A fixed price, clear scope and timeline in writing, usually within a few days." },
  { when: "Step 03", role: "The work", desc: "Done in your cloud accounts and code repositories, with a weekly update on progress." },
  { when: "Step 04", role: "Handover", desc: "Documentation, runbooks and a walkthrough for your team. Ongoing support is optional, not required." },
];

const faqs = [
  { q: "Do you work on-site?", a: "Yes. Codeworks is based in Mesa and can be on-site anywhere in the Phoenix metro for kickoffs, workshops and planning sessions. Day-to-day work is remote." },
  { q: "Who will actually do the work?", a: "Neel Thomas Thelly, the founder. You talk directly to the engineer doing the work, not an account manager." },
  { q: "We're a small company. Is this for us?", a: "Yes. Small teams often get the most out of it. The goal is the simplest setup that's reliable, and sometimes that means a managed service instead of Kubernetes." },
  { q: "Do you replace our IT provider?", a: "No. Codeworks handles cloud infrastructure, DevOps and AI systems for your software. Your managed IT provider keeps handling laptops, email and office IT. The two work well side by side." },
  { q: "Which clouds and AI models do you work with?", a: "Mainly AWS and Azure. For AI, hosted models like Claude and AWS Bedrock, or self-hosted open-weight models when your data has to stay in your own environment." },
  { q: "What happens to our data?", a: "All work happens in your accounts, under your access controls. Nothing is copied to outside systems, and we're happy to sign an NDA." },
  { q: "How does pricing work?", a: "Projects are fixed-price, quoted in writing after the free consultation. The Fractional DevOps Lead is a monthly fee. No long-term contracts." },
];

const site = Astro.site!.href;
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
  ...services.map((s) => ({
    "@context": "https://schema.org",
    "@type": "Service",
    name: s.title,
    description: s.desc,
    provider: { "@id": `${site}#business` },
    areaServed: { "@type": "State", name: "Arizona" },
    url: `${site}#services`,
  })),
];
---

<Base isHome={true} schema={schema}>

  <!-- ===================== HERO ===================== -->
  <section class="hero">
    <div class="wrap">
      <div class="hero__top rise">
        <span class="live"><span class="nav__dot" aria-hidden="true"></span> taking new projects</span>
        <span class="hero__sep">/</span>
        <span>Mesa, AZ</span>
        <span class="right">Phoenix · Scottsdale · Tempe · Chandler · Gilbert</span>
      </div>

      <div class="hero__grid">
        <div>
          <h1 class="hero__name rise" style="animation-delay:.06s">
            <span class="ln">AI, Cloud &</span>
            <span class="ln">DevOps Consulting</span>
            <span class="ln ln--accent">in Phoenix.</span>
          </h1>
          <p class="hero__role rise" style="animation-delay:.16s">
            <b>fixed-price projects</b> <span class="tick">·</span> senior engineer only <span class="tick">·</span> no long contracts
          </p>
          <p class="hero__sub rise" style="animation-delay:.24s">
            Codeworks sets up, fixes and runs the infrastructure behind your software.
            Cloud, Kubernetes, deployments, monitoring, and AI systems your team can
            trust with real customers.
          </p>
          <div class="btn-row rise" style="animation-delay:.32s">
            <a class="btn btn--primary" href={booking} target="_blank" rel="noopener">Book a free consultation ↗</a>
            <a class="btn" href="#services">View services</a>
          </div>
        </div>

        <aside class="panel rise" style="animation-delay:.4s" aria-label="Codeworks at a glance">
          <div class="panel__head"><span class="nav__dot" aria-hidden="true" style="animation:none"></span> at a glance</div>
          <div class="panel__row"><span class="panel__k">availability</span><span class="panel__v panel__v--ok"><span class="led" aria-hidden="true"></span> open</span></div>
          <div class="panel__row"><span class="panel__k">based in</span><span class="panel__v">Mesa, AZ</span></div>
          <div class="panel__row"><span class="panel__k">experience</span><span class="panel__v">10+ years</span></div>
          <div class="panel__row"><span class="panel__k">largest system</span><span class="panel__v">100M+ users</span></div>
          <div class="panel__row"><span class="panel__k">cloud savings</span><span class="panel__v">$336K / yr</span></div>
          <div class="panel__row"><span class="panel__k">reply time</span><span class="panel__v">1 business day</span></div>
          <div class="panel__live">
            <div class="panel__live-head"><span>req latency · p50</span><span class="panel__ms" data-ms>— ms</span></div>
            <svg class="spark" viewBox="0 0 240 48" preserveAspectRatio="none" aria-hidden="true">
              <polyline class="spark__line" points=""></polyline>
              <circle class="spark__dot" cx="240" cy="24" r="2.6"></circle>
            </svg>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- ===================== SOUND FAMILIAR ===================== -->
  <section class="sec" id="problems">
    <div class="wrap">
      <p class="eyebrow reveal">Common problems</p>
      <h2 class="sec__title reveal" data-d="1">Sound familiar?</h2>
      <ul class="checks">
        {symptoms.map((s, i) => (
          <li class="reveal" data-d={String((i % 2) + 1)}>{s}</li>
        ))}
      </ul>
      <p class="sec__intro reveal">If two or more of these apply, a free consultation is worth your time.</p>
    </div>
  </section>

  <!-- ===================== SERVICES ===================== -->
  <section class="sec" id="services">
    <div class="wrap">
      <p class="eyebrow reveal">Services</p>
      <h2 class="sec__title reveal" data-d="1">What Codeworks does</h2>
      <p class="sec__intro reveal" data-d="2">
        Most clients start with an assessment. Every project has a fixed price and a
        written scope before any work begins.
      </p>
      <div class="proj-grid">
        {services.map((s, i) => (
          <article class="proj reveal" data-d={String((i % 2) + 1)}>
            <span class="proj__idx">{String(i + 1).padStart(2, "0")}</span>
            <span class="proj__tag"><span class="led"></span> {s.tag}</span>
            <h3 class="proj__title">{s.title}</h3>
            <p class="proj__desc">{s.desc}</p>
            <div class="stack">{s.stack.map((t) => <span class="chip">{t}</span>)}</div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== RESULTS ===================== -->
  <section class="sec" id="work">
    <div class="wrap">
      <p class="eyebrow reveal">Results</p>
      <h2 class="sec__title reveal" data-d="1">Past work, real numbers</h2>
      <p class="sec__intro reveal" data-d="2">
        Selected results from Neel's 10+ years running production systems at
        companies from early-stage fintech to apps with 100M+ users.
      </p>
      <div class="proj-grid">
        {results.map((r, i) => (
          <article class="proj reveal" data-d={String((i % 2) + 1)}>
            <span class="proj__tag"><span class="led"></span> {r.co}</span>
            <h3 class="proj__title">{r.metric}</h3>
            <p class="proj__desc"><b>Challenge.</b> {r.challenge}</p>
            <p class="proj__desc"><b>What was done.</b> {r.work}</p>
          </article>
        ))}
      </div>

      <h3 class="sub__title reveal">AI tools built in the open</h3>
      <div class="proj-grid proj-grid--tight">
        {projects.map((p, i) => (
          <article class="proj reveal" data-d={String((i % 2) + 1)}>
            <span class="proj__tag proj__tag--oss"><span class="led"></span> {p.tag}</span>
            <h3 class="proj__title">{p.title}</h3>
            <p class="proj__desc" set:html={p.desc}></p>
            <div class="stack">{p.stack.map((s) => <span class="chip">{s}</span>)}</div>
            <a class="proj__link" href={p.href} target="_blank" rel="noopener" aria-label={`${p.title} on GitHub`}>↗</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== FIT ===================== -->
  <section class="sec" id="fit">
    <div class="wrap">
      <p class="eyebrow reveal">Who we work with</p>
      <h2 class="sec__title reveal" data-d="1">Built for Arizona software teams</h2>
      <div class="skills">
        <div class="skillcard reveal" data-d="1">
          <h3 class="skillcard__h">A good fit</h3>
          <ul class="fit">{goodFit.map((t) => <li>{t}</li>)}</ul>
        </div>
        <div class="skillcard reveal" data-d="2">
          <h3 class="skillcard__h">Not a fit</h3>
          <ul class="fit fit--no">{notFit.map((t) => <li>{t}</li>)}</ul>
        </div>
        {coverage.map((g, i) => (
          <div class="skillcard reveal" data-d={String((i % 2) + 1)}>
            <h3 class="skillcard__h">{g.h}</h3>
            <div class="stack">{g.tags.map((t) => <span class="chip">{t}</span>)}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== PROCESS ===================== -->
  <section class="sec" id="process">
    <div class="wrap">
      <p class="eyebrow reveal">How it works</p>
      <h2 class="sec__title reveal" data-d="1">Four simple steps</h2>
      <div class="tl">
        {steps.map((s) => (
          <div class="tl__item reveal">
            <span class="tl__node" aria-hidden="true"></span>
            <span class="tl__when">{s.when}</span>
            <h3 class="tl__role">{s.role}</h3>
            <p class="tl__desc">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== FAQ ===================== -->
  <section class="sec" id="faq">
    <div class="wrap">
      <p class="eyebrow reveal">FAQ</p>
      <h2 class="sec__title reveal" data-d="1">Common questions</h2>
      <div class="faq">
        {faqs.map((f) => (
          <details class="faq__item reveal">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== CLOSING ===================== -->
  <section class="cta-band" id="contact-cta">
    <div class="wrap">
      <p class="eyebrow reveal" style="justify-content:center">Get in touch</p>
      <h2 class="reveal" data-d="1">Infrastructure problems?<br><span class="accent">Let's fix them.</span></h2>
      <p class="reveal" data-d="2">Free consultation, no sales pitch. Tell us what's broken or what you want to build, and you'll get an honest answer on whether Codeworks can help.</p>
      <div class="btn-row reveal" data-d="3">
        <a class="btn btn--primary" href={booking} target="_blank" rel="noopener">Book a free consultation ↗</a>
        <a class="btn" href="mailto:neeltom92@gmail.com">neeltom92@gmail.com</a>
      </div>
    </div>
  </section>

</Base>
